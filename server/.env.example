# 应用配置
PORT=3000
NODE_ENV=development

# 数据库
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/splitter_dev?schema=public

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# 微信小程序
WX_APPID=your-wx-appid
WX_SECRET=your-wx-secret

# 身份证加密密钥
ID_CARD_AES_KEY=your-32-char-aes-key-here000000
