# ========== 测试环境变量 ==========
# 注意：此文件仅作为模板，真实 .env.test 只在服务器上手动创建，绝不提交到 Git

COMPOSE_PROJECT_NAME=splitter_test
ENV=test

# 后端
BACKEND_PORT=3001
BACKEND_IMAGE=ghcr.io/xspace0/splitter-backend
BACKEND_SHA=latest

# 数据库
DATABASE_URL=postgresql://test_user:test_pass@postgres:5432/splitter_test?schema=public
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_TEST_PASS
POSTGRES_DB=splitter_test

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=CHANGE_ME_TEST_REDIS

# JWT
JWT_SECRET=CHANGE_ME_TEST_SECRET
JWT_EXPIRES_IN=7d

# 前端
FRONTEND_PORT=8081
FRONTEND_IMAGE=ghcr.io/xspace0/splitter-frontend
FRONTEND_SHA=latest
API_BASE_URL=http://YOUR_SERVER_IP:3001
