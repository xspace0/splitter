# ========== 测试环境变量 ==========
# 注意：此文件仅作为模板，真实 .env.test 只在服务器上手动创建，绝不提交到 Git

COMPOSE_PROJECT_NAME=splitter_test
ENV=test

# 后端
BACKEND_PORT=3001
BACKEND_IMAGE=ghcr.io/xspace0/splitter-backend
BACKEND_SHA=latest

# 数据库
DATABASE_URL=postgresql://test_user:test_pass@postgres:5432/splitter_test?schema=public&connect_timeout=10&pool_timeout=10
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_TEST_PASS
POSTGRES_DB=splitter_test

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=CHANGE_ME_TEST_REDIS

# JWT
JWT_SECRET=CHANGE_ME_TEST_SECRET
JWT_EXPIRES_IN=7d

# 前端
FRONTEND_PORT=8081
FRONTEND_IMAGE=ghcr.io/xspace0/splitter-frontend
FRONTEND_SHA=latest
# 浏览器使用的 API 地址：保持 /api 走同源 nginx 反向代理，
# 不要把后端端口直接暴露给浏览器（HTTPS 下会变成混合内容）
API_BASE_URL=/api
# nginx 反向代理的上游（容器网络内的后端服务地址）
API_UPSTREAM=http://backend-test:3000
