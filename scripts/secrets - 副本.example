# ========== GitHub Secrets 本地配置模板 ==========
# 使用步骤：
#   1. 复制本文件为 secrets.local
#      cp secrets.example secrets.local
#   2. 编辑 secrets.local，填入你的真实值
#      vim secrets.local   （或用记事本/VS Code）
#   3. 运行 setup-secrets.sh 自动上传
#      bash setup-secrets.sh
#
# 重要：secrets.local 已加入 .gitignore，不会被提交
# 千万别把真实密钥提交到 Git！

# 服务器公网 IP（例如 "123.45.67.89"）
SERVER_HOST="YOUR_SERVER_IP"

# SSH 登录用户名（一般是 "root"）
SERVER_USERNAME="root"

# SSH 私钥内容（完整的，包括 -----BEGIN 和 -----END 行）
# 注意 bash 多行字符串用 $'...' 或 EOF 方式
SSH_PRIVATE_KEY="-----BEGIN OPENSSH PRIVATE KEY-----
把你的私钥内容粘贴在这里
替换掉这几行
保留 BEGIN 和 END 行
-----END OPENSSH PRIVATE KEY-----"
